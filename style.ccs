@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Sarabun', sans-serif;
}

body {
    /* พื้นหลังโทนขาวอมชมพูอ่อน */
    background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 50%, #fce4ec 100%);
    color: #4a4a4a;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 15px;
}

/* คอนเทนเนอร์หลัก จัดกึ่งกลางหน้าจอ */
.container {
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid #f8bbd0;
    border-radius: 24px;
    padding: 35px 25px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 10px 30px rgba(244, 143, 177, 0.25);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: auto;
}

/* กรอบรูปโปรไฟล์ */
.profile-card {
    border: 3px solid #f48fb1;
    border-radius: 18px;
    padding: 6px;
    margin-bottom: 20px;
    background: #ffffff;
    box-shadow: 0 6px 16px rgba(244, 143, 177, 0.2);
    width: 100%;
    max-width: 280px;
}

.profile-img {
    width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
}

/* หัวข้อ */
.main-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #ec407a;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #ec407a;
    margin-bottom: 20px;
    text-align: center;
    width: 100%;
}

/* ข้อความบรรยาย */
.description {
    width: 100%;
    margin-bottom: 10px;
}

.description p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 6px;
}

.description strong {
    color: #d81b60;
    font-size: 1.25rem;
}

/* ปุ่มกด */
.btn-group {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
    width: 100%;
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 24px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background: linear-gradient(135deg, #f48fb1 0%, #ec407a 100%);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(236, 64, 122, 0.3);
}

.btn-primary:hover {
    background: linear-gradient(135deg, #ec407a 0%, #d81b60 100%);
    transform: translateY(-2px);
}

.btn-secondary {
    background: #ffffff;
    color: #ad1457;
    border: 2px solid #f8bbd0;
}

.btn-secondary:hover {
    background: #fce4ec;
}

/* หน้า About Me */
.info-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
}

.info-item {
    background: #fff5f8;
    border: 1px solid #f8bbd0;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1rem;
}

.info-label {
    color: #c2185b;
    font-weight: 600;
}

.info-value {
    color: #333333;
}

/* หน้า Portfolio (ผลงาน) */
.portfolio-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    width: 100%;
}

.portfolio-card {
    background: #ffffff;
    border: 2px solid #f8bbd0;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
    padding: 8px;
    box-shadow: 0 4px 12px rgba(244, 143, 177, 0.15);
    width: 100%;
}

.portfolio-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
}
