@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');

* {
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    font-family: 'Sarabun', sans-serif !important;
}

body {
    background-color: #fff0f5 !important;
    background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 50%, #fce4ec 100%) !important;
    color: #4a4a4a !important;
    min-height: 100vh !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 20px 15px !important;
}

.container {
    background: #ffffff !important;
    border: 2px solid #f8bbd0 !important;
    border-radius: 24px !important;
    padding: 35px 25px !important;
    width: 100% !important;
    max-width: 480px !important;
    box-shadow: 0 10px 30px rgba(244, 143, 177, 0.3) !important;
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    margin: auto !important;
}

.profile-card {
    border: 3px solid #f48fb1 !important;
    border-radius: 18px !important;
    padding: 6px !important;
    margin-bottom: 20px !important;
    background: #ffffff !important;
    box-shadow: 0 6px 16px rgba(244, 143, 177, 0.2) !important;
    width: 100% !important;
    max-width: 280px !important;
}

.profile-img {
    width: 100% !important;
    height: 320px !important;
    object-fit: cover !important;
    border-radius: 12px !important;
    display: block !important;
}

.main-title {
    font-size: 2.5rem !important;
    font-weight: 700 !important;
    color: #ec407a !important;
    letter-spacing: 2px !important;
    margin-bottom: 12px !important;
}

.page-title {
    font-size: 2rem !important;
    font-weight: 700 !important;
    color: #ec407a !important;
    margin-bottom: 20px !important;
    text-align: center !important;
    width: 100% !important;
}

.description {
    width: 100% !important;
    margin-bottom: 10px !important;
}

.description p {
    font-size: 1.1rem !important;
    line-height: 1.6 !important;
    color: #555555 !important;
    margin-bottom: 6px !important;
}

.description strong {
    color: #d81b60 !important;
    font-size: 1.25rem !important;
}

.btn-group {
    display: flex !important;
    gap: 12px !important;
    justify-content: center !important;
    align-items: center !important;
    margin-top: 20px !important;
    width: 100% !important;
}

.btn {
    display: inline-flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 12px 24px !important;
    border-radius: 25px !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 1rem !important;
    transition: all 0.3s ease !important;
    border: none !important;
    cursor: pointer !important;
}

.btn-primary {
    background: linear-gradient(135deg, #f48fb1 0%, #ec407a 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(236, 64, 122, 0.3) !important;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #ec407a 0%, #d81b60 100%) !important;
    transform: translateY(-2px) !important;
}

.btn-secondary {
    background: #ffffff !important;
    color: #ad1457 !important;
    border: 2px solid #f8bbd0 !important;
}

.btn-secondary:hover {
    background: #fce4ec !important;
}

.info-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    width: 100% !important;
}

.info-item {
    background: #fff5f8 !important;
    border: 1px solid #f8bbd0 !important;
    border-radius: 12px !important;
    padding: 12px 16px !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 1rem !important;
}

.info-label {
    color: #c2185b !important;
    font-weight: 600 !important;
}

.info-value {
    color: #333333 !important;
}

.portfolio-header {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 10px !important;
    margin-bottom: 20px !important;
    width: 100% !important;
}

/* กรอบเกียรติบัตรย่อลงเท่ากันทุกใบ */
.portfolio-card {
    background: #ffffff !important;
    border: 2px solid #f8bbd0 !important;
    border-radius: 14px !important;
    overflow: hidden !important;
    margin-bottom: 14px !important;
    padding: 8px !important;
    box-shadow: 0 4px 12px rgba(244, 143, 177, 0.15) !important;
    width: 100% !important;
    height: 220px !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}

.portfolio-img {
    max-width: 100% !important;
    max-height: 100% !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    border-radius: 8px !important;
    display: block !important;
}
