@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Sarabun', sans-serif !important;
}

body {
    background-color: #fff0f5 !important;
    background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 50%, #fce4ec 100%) !important;
    color: #4a4a4a !important;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 15px;
}

.container {
    background: #ffffff !important;
    border: 2px solid #f8bbd0 !important;
    border-radius: 24px !important;
    padding: 35px 25px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 10px 30px rgba(244, 143, 177, 0.3) !important;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: auto;
}

.profile-card {
    border: 3px solid #f48fb1 !important;
    border-radius: 18px;
    padding: 6px;
    margin-bottom: 20px;
    background: #ffffff !important;
    box-shadow: 0 6px 16px rgba(244, 143, 177, 0.2);
    width: 100%;
    max-width: 280px;
}

.profile-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
}

.main-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #ec407a !important;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #ec407a !important;
    margin-bottom: 20px;
    text-align: center;
    width: 100%;
}

.description {
    width: 100%;
    margin-bottom: 10px;
}

.description p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #555555 !important;
    margin-bottom: 6px;
}

.description strong {
    color: #d81b60 !important;
    font-size: 1.25rem;
}

.btn-group {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
    width: 100%;
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 24px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background: linear-gradient(135deg, #f48fb1 0%, #ec407a 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(236, 64, 122, 0.3) !important;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #ec407a 0%, #d81b60 100%) !important;
    transform: translateY(-2px);
}

.btn-secondary {
    background: #ffffff !important;
    color: #ad1457 !important;
    border: 2px solid #f8bbd0 !important;
}

.btn-secondary:hover {
    background: #fce4ec !important;
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
}

.info-item {
    background: #fff5f8 !important;
    border: 1px solid #f8bbd0 !important;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1rem;
}

.info-label {
    color: #c2185b !important;
    font-weight: 600;
}

.info-value {
    color: #333333 !important;
}

.portfolio-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    width: 100%;
}

/* กรอบรูปเกียรติบัตรขนาดเท่ากันทุกใบ */
.portfolio-card {
    background: #ffffff !important;
    border: 2px solid #f8bbd0 !important;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
    padding: 10px;
    box-shadow: 0 4px 12px rgba(244, 143, 177, 0.15) !important;
    width: 100%;
    height: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
}

/* รูปภาพปรับขนาดพอดีกรอบ ไม่โดนตัดขอบ */
.portfolio-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    display: block;
}
